# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=local

# Postgres
DATABASE_URL=postgresql+psycopg://nfl_confidence:nfl_confidence@localhost:5432/nfl_confidence

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=dev-only-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Email (Resend). Leave blank locally to fall back to console logging.
RESEND_API_KEY=
EMAIL_FROM=noreply@nfl-confidence-pool.local

# NFL data (ESPN hidden API requires no key; placeholder kept for future provider swap)
NFL_API_KEY=

# App
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
