# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=local
ENABLE_SCHEDULER=true

# Postgres
DATABASE_URL=postgresql+psycopg://nfl_confidence:nfl_confidence@localhost:5432/nfl_confidence

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TIMEOUT_SECONDS=8
GOOGLE_OAUTH_REDIRECT_URL=
JWT_SECRET=dev-only-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Email (Resend). Leave blank locally to fall back to console logging.
RESEND_API_KEY=
EMAIL_FROM=noreply@nfl-confidence-pool.local

# NFL data (ESPN hidden API requires no key; placeholder kept for future provider swap)
NFL_API_KEY=
NFL_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl
NFL_API_TIMEOUT_SECONDS=10

# App
APP_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
